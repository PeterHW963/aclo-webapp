{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "crons": [
        {
            "path": "/api/cron/checkout-reminders",
            "schedule": "0 * * * *"
        }
    ],
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        {
            "source": "/(.*)",
            "destination": "/server.js"
        }
    ]
}
